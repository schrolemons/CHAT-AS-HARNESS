{
  "id": "ctx-memory-profile-facts",
  "name": "用户画像记忆插件",
  "version": "0.1.0",
  "description": "从新的来信里挑出值得记进全局用户画像的事实（称呼/喜好/雷点/近况/名言），交给 AI 用 qq_memory_append 落库；桥接只负责攒素材、控频率、拼提示词。",
  "main": "index.js",
  "enabled": true,
  "category": "上下文与记忆",
  "order": 6,
  "tags": [
    "画像",
    "印象"
  ],
  "hooks": [
    "onIncoming",
    "beforePrompt",
    "onTick"
  ],
  "schedule": {
    "everyMs": 1800000
  },
  "config": {
    "cooldownMs": 600000,
    "maxSnippets": 6,
    "maxCharsPerSnippet": 120
  },
  "layer": "C"
}
